# Copy this file to .env and fill in your own key.
# Never commit the real .env file. It is already listed in .gitignore.

# Required for `superdocs-fidelity run` (the live round trip against SuperDocs).
# Not required for `superdocs-fidelity validate` (pure local structural diff).
SUPERDOCS_API_KEY=sk_your_api_key_here

# Rarely need to change these.
SUPERDOCS_BASE_URL=https://api.superdocs.app
SUPERDOCS_REQUEST_TIMEOUT_SECONDS=60
SUPERDOCS_POLL_INTERVAL_SECONDS=2
SUPERDOCS_MAX_POLL_SECONDS=1800

# Budget guard default. Overridable per-run with --cost-cap.
SUPERDOCS_DEFAULT_COST_CAP=5

# AI model tier / thinking depth used for the edit instruction in `run`.
# See https://docs.superdocs.app/guides/model-selection
SUPERDOCS_MODEL_TIER=core
SUPERDOCS_THINKING_DEPTH=balanced

# A document with more chunks than this is considered "not small" by
# --small-sample and the harness will refuse to run it in that mode.
SUPERDOCS_SMALL_SAMPLE_CHUNK_LIMIT=40
